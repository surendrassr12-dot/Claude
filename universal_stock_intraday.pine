//@version=6
// ==========================================================================
// Universal Stock Intraday — one script for any liquid NSE stock (1m / 3m)
// --------------------------------------------------------------------------
// Why it works on any stock without re-tuning:
//   * No fixed "points". Every distance is a multiple of ATR, so a ₹300
//     stock and a ₹3,000 stock are treated identically.
//   * Quantity is sized from risk: qty = (capital × risk%) / stop distance.
//     A more volatile stock automatically gets fewer shares.
//   * Intraday costs (brokerage, STT, exchange, GST, stamp) + 1-tick
//     slippage are charged on every fill, so the Strategy Tester shows net
//     results, not gross.
//
// Logic (ideas borrowed from Alpha/Beta/Gamma, but normalized):
//   1. Trend   : fast EMA > slow EMA, price on the right side of session
//                VWAP, and the same EMA alignment on a higher timeframe
//                (like your 3-min HTF macro filter).
//   2. Regime  : ADX ≥ threshold and ATR not compressed (your squeeze
//                shield, ATR-based) — sit out choppy/sideways tape.
//   3. Trigger : pullback — the bar dips to the fast EMA and closes back in
//                the trend direction (no chasing; like your entry-distance
//                filter).
//   4. Exits   : ATR stop → break-even + ATR trail once trade is +1R →
//                R-multiple target → hard square-off 15:10.
//   5. Day risk: max trades/day, stop for the day after −2R, cooldown bars.
// ==========================================================================
strategy("Universal Stock Intraday", overlay=true,
     initial_capital=100000, currency=currency.INR,
     commission_type=strategy.commission.percent, commission_value=0.04,
     slippage=1, process_orders_on_close=true, max_labels_count=500)
// commission 0.04%/side ≈ Zerodha MIS equity: brokerage 0.03% capped ₹20
// (~0.02% on a ₹1L ticket) + STT 0.025% sell-only (0.0125% avg/side)
// + exchange/SEBI/stamp/GST (~0.006%/side).

// ---------- 1. Inputs ----------
g1 = "1. Trend"
int    emaFastLen = input.int(20, "Fast EMA", group=g1)
int    emaSlowLen = input.int(50, "Slow EMA", group=g1)
bool   useHTF     = input.bool(true, "Higher-TF trend filter", group=g1)
string htfRes     = input.timeframe("15", "Higher TF", group=g1)
bool   useVWAP    = input.bool(true, "Price must be on trend side of VWAP", group=g1)

g2 = "2. Regime"
int   adxLen       = input.int(14, "ADX length", group=g2)
float adxMin       = input.float(20, "Min ADX", group=g2)
int   atrLen       = input.int(14, "ATR length", group=g2)
float squeezeRatio = input.float(0.8, "Skip if ATR < x × 100-bar avg ATR", step=0.05, group=g2)

g3 = "3. Risk & exits (ATR multiples)"
float slATR    = input.float(1.5, "Initial stop (× ATR)", step=0.1, group=g3)
float targetR  = input.float(2.0, "Target (R multiple, 0 = off)", step=0.25, group=g3)
float trailATR = input.float(2.0, "Trail distance after +1R (× ATR)", step=0.1, group=g3)
float riskPct  = input.float(0.5, "Risk per trade (% of capital)", step=0.1, group=g3)
float maxPosX  = input.float(1.0, "Max position value (× capital)", step=0.5, group=g3)

g4 = "4. Session & daily risk"
string tradeWin   = input.session("0945-1430", "Entry window", group=g4)
int    sqHour     = input.int(15, "Square-off hour", group=g4)
int    sqMin      = input.int(10, "Square-off minute", group=g4)
int    maxTrades  = input.int(3, "Max trades per day", group=g4)
float  dayLossR   = input.float(2.0, "Stop for the day after loss of (R)", group=g4)
int    coolBars   = input.int(5, "Cooldown bars after an exit", group=g4)
bool   allowShort = input.bool(true, "Allow intraday shorts (MIS)", group=g4)

// ---------- 2. Indicators ----------
float emaF = ta.ema(close, emaFastLen)
float emaS = ta.ema(close, emaSlowLen)
float vw   = ta.vwap(hlc3)
float atr  = ta.atr(atrLen)
[_, _, adx] = ta.dmi(adxLen, adxLen)

// Previous *completed* HTF bar only — no repainting / lookahead.
float htfF = request.security(syminfo.tickerid, htfRes, ta.ema(close, emaFastLen)[1], lookahead=barmerge.lookahead_on)
float htfS = request.security(syminfo.tickerid, htfRes, ta.ema(close, emaSlowLen)[1], lookahead=barmerge.lookahead_on)
bool htfUp = not useHTF or htfF > htfS
bool htfDn = not useHTF or htfF < htfS

bool trendUp  = emaF > emaS and (not useVWAP or close > vw) and htfUp
bool trendDn  = emaF < emaS and (not useVWAP or close < vw) and htfDn
bool regimeOK = adx >= adxMin and atr >= squeezeRatio * ta.sma(atr, 100)

bool longTrig  = low  <= emaF and close > emaF and close > open
bool shortTrig = high >= emaF and close < emaF and close < open

// ---------- 3. Day state ----------
var int   tradesToday = 0
var float dayR        = 0.0
var int   lastExitBar = -1000
if ta.change(time("D")) != 0
    tradesToday := 0
    dayR        := 0.0

// Book R for every trade that closed since last bar
var int   seenClosed = 0
var float tradeRisk  = na     // ₹ risked on the open trade (stop dist × qty)
while seenClosed < strategy.closedtrades
    dayR        += strategy.closedtrades.profit(seenClosed) / nz(tradeRisk, 1)
    lastExitBar := bar_index
    seenClosed  += 1

bool inWin    = not na(time(timeframe.period, tradeWin))
bool sqOff    = hour > sqHour or (hour == sqHour and minute >= sqMin)
bool flat     = strategy.position_size == 0
bool canTrade = flat and inWin and not sqOff and tradesToday < maxTrades and dayR > -dayLossR and bar_index - lastExitBar > coolBars and regimeOK

// ---------- 4. Orders ----------
var float entryPx = na
var float rps     = na   // risk per share
var float stopPx  = na
var float tgtPx   = na
var float bestPx  = na

if canTrade and not na(atr)
    float dist = slATR * atr
    int   q    = int(math.max(math.floor(math.min(strategy.initial_capital * riskPct / 100 / dist, strategy.initial_capital * maxPosX / close)), 0))
    if q > 0 and trendUp and longTrig
        strategy.entry("L", strategy.long, qty=q)
        entryPx := close
        rps     := dist
        stopPx  := close - dist
        tgtPx   := targetR > 0 ? close + targetR * dist : na
        bestPx  := close
        tradeRisk := dist * q
        tradesToday += 1
    else if q > 0 and allowShort and trendDn and shortTrig
        strategy.entry("S", strategy.short, qty=q)
        entryPx := close
        rps     := dist
        stopPx  := close + dist
        tgtPx   := targetR > 0 ? close - targetR * dist : na
        bestPx  := close
        tradeRisk := dist * q
        tradesToday += 1

// Trail at bar close; the new stop applies from the next bar.
if strategy.position_size > 0
    bestPx := math.max(bestPx, high)
    if bestPx - entryPx >= rps
        stopPx := math.max(stopPx, entryPx, bestPx - trailATR * atr)
else if strategy.position_size < 0
    bestPx := math.min(bestPx, low)
    if entryPx - bestPx >= rps
        stopPx := math.min(stopPx, entryPx, bestPx + trailATR * atr)

strategy.exit("XL", "L", stop=stopPx, limit=tgtPx, comment_loss="STOP", comment_profit="TARGET")
strategy.exit("XS", "S", stop=stopPx, limit=tgtPx, comment_loss="STOP", comment_profit="TARGET")
if sqOff and not flat
    strategy.close_all(comment="EOD")

// ---------- 5. Visuals ----------
plot(emaF, "Fast EMA", color=color.aqua)
plot(emaS, "Slow EMA", color=color.orange)
plot(vw,   "VWAP", color=color.new(color.gray, 30), style=plot.style_circles)
plot(not flat ? stopPx : na, "Stop",   color=color.red,   style=plot.style_linebr)
plot(not flat ? tgtPx  : na, "Target", color=color.green, style=plot.style_linebr)
bgcolor(not regimeOK ? color.new(color.gray, 92) : na, title="No-trade regime")

// ---------- 6. Alerts (for automation later) ----------
if canTrade and trendUp and longTrig
    alert('{"ticker":"' + syminfo.ticker + '","action":"BUY","signal_type":"ENTRY","strategy":"Universal"}', alert.freq_once_per_bar_close)
if canTrade and allowShort and trendDn and shortTrig and not (trendUp and longTrig)
    alert('{"ticker":"' + syminfo.ticker + '","action":"SELL","signal_type":"ENTRY","strategy":"Universal"}', alert.freq_once_per_bar_close)
